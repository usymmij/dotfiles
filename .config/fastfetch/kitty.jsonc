// logo from https://github.com/GuardKenzie/pfetch-with-kitties

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/kitty.txt",
        "padding": {
            "top": 3,
            "left": 2,
            "bottom": 1,
            "right": 1
        },
        "color": {
            "1": "blue"
        }
    },
    "display": {
        "key": {
            "width": 15
        },
        "bar": {
            "char": {
                "elapsed": "=",
                "total": "-"
            },
            "width": 13
        },
        "percent": {
            "type": 2
        },
        "constants": [
            "───────────────────────────────────────────────────────",
            "│\u001b[55C│\u001b[55D"
        ]
    },
    "modules": [
        {"type": "custom"},
        {
            "format": "{#1}{#keys}╭{$1}╮\u001b[56D  {user-name-colored}{at-symbol-colored}{host-name-colored} ",
            "type": "title"
        },
        {
            "key": "{$2}{#35}󰍛 cpu         ",
            "type": "cpu",
            "format": "{name}"
        },
        {
            "key": "{$2}{#35}              ",
            "type": "cpuusage"
        },
        {
            "key": "{$2}{#32} memory      ",
            "type": "memory",
            "format": "{used} / {total}"

        },
        {
            "key": "{$2}                    ",
            "type": "memory",
            "format": "{percentage-bar}"

        },
        {
            "key": "{$2}{#34}󰍛 gpu         ",
            "type": "gpu"
        },
        {
            "key": "{$2}{#31} colors           ",
            "paddingLeft": 0,
            "symbol": "circle",
            "type": "colors"
        },
        {
            "format": "{#1}{#keys}╰{$1}╯",
            "type": "custom"
        },

        {"type": "custom"}
    ]
}
